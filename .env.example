# 값을 채운 .env 는 커밋하지 않는다. 여기에는 이름만 둔다.
# 각 변수의 용도는 docs/01-기술-스택.md §3.2.

# 비밀값 — 배포 환경에서는 Secrets Manager
DATABASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
KSPO_SERVICE_KEY=
KSPO_ENDPOINT=

# 설정 — 배포 환경에서는 SSM Parameter Store
MLFLOW_TRACKING_URI=
VECTOR_BACKEND=faiss
SIM_THRESHOLD=0.57
LABELER_BACKEND=llama
LLAMA_SERVER_URL=http://127.0.0.1:8081
EMBEDDING_URL=http://127.0.0.1:8082
LABELER_MODEL=
# docs/dev/AI-10 §6 ④ — coach/messages 의 답 문구를 LLM 이 쓰나. 기본은 꺼짐.
# 켜면 ANTHROPIC_API_KEY 가 있어야 한다 — 없으면 503 으로 드러난다(조용히 발췌로 가지 않는다).
COACH_LLM=
# claude | gemini — 어느 LLM 이 문구를 쓰나 (기본 claude).
# 고른 쪽의 키가 있어야 한다. 비우면 그 백엔드의 기본 모델이다.
COACH_BACKEND=
COACH_MODEL=
