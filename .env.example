# 값을 채운 .env 는 커밋하지 않는다. 여기에는 이름과 뜻만 둔다.

# ── 비밀값 ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# 영상 목록을 다시 받아올 때만 쓴다. 서비스는 쓰지 않는다.
YOUTUBE_API_KEY=
# 공공데이터포털 키 — 「디코딩」 쪽을 적는다. make kspo KSPO_ARGS=--fetch 할 때만 쓴다.
DATA_GO_KR_KEY=

# ── 검색 ──────────────────────────────────────────────────────────────
# 임베딩을 어디서 돌리나 — local | http. 비우면 local.
#   local  이 프로세스 안에서 돈다. pip install -e ".[embed]" 와 make embed-model 을
#          한 번 해 두면 임베딩 서버를 따로 띄우지 않는다.
#   http   밖에 띄운 llama.cpp 서버에 묻는다 (아래 EMBEDDING_URL).
# 어느 쪽이든 인덱스를 만든 모델(bge-m3-Q8_0.gguf)과 같아야 한다.
EMBEDDING_BACKEND=
# local 이 읽을 모델 파일. 비우면 허깅페이스 캐시의 gpustack/bge-m3-GGUF 를 쓴다.
EMBEDDING_GGUF=
# http 일 때만 쓴다.
#   llama-server -hf gpustack/bge-m3-GGUF -hff bge-m3-Q8_0.gguf --embedding --port 8082
EMBEDDING_URL=http://127.0.0.1:8082
# 이 아래 점수는 근거로 치지 않는다.
SIM_THRESHOLD=0.57

# ── 코치 ──────────────────────────────────────────────────────────────
# 편성과 문구를 LLM 이 맡나. 비우면 켜짐이다. 끄려면 0.
# 꺼도, 키가 없어도, 부르다 넘어져도 규칙 편성이 대신 선다 — 서비스는 멈추지 않는다.
COACH_LLM=
# claude | gemini — 먼저 부를 쪽 (기본 claude). 그쪽이 붐비면 다른 쪽으로 넘어간다.
# 키가 한쪽만 있으면 있는 쪽으로 간다.
COACH_BACKEND=
# 비우면 그 백엔드의 기본 모델 (claude-opus-5 · gemini-flash-latest).
# 모델 이름이 백엔드를 말해 주므로 여기만 고쳐도 된다 — COACH_BACKEND 와 어긋나면
# 모델 쪽을 따른다.
#   claude-opus-5 · claude-sonnet-5 · claude-haiku-4-5 · gemini-flash-latest
COACH_MODEL=
